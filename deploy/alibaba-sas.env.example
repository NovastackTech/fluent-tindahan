# Alibaba Cloud Simple Application Server (SAS) deploy settings
# Copy to deploy/alibaba-sas.env (gitignored) and fill in secrets.

# SSH target (shared Novastack SAS)
SAS_HOST=8.220.128.80
SAS_USER=root
SAS_PORT=22
# Absolute path to private key, or leave empty to use ssh-agent / default key
SAS_SSH_KEY=

# Remote install directory on the SAS instance
SAS_APP_DIR=/opt/fluent-tindahan

# Public hostname + URL (DNS already points at the SAS)
PUBLIC_HOST=tindahan-dev.novastack-inc.online
PUBLIC_ORIGIN=https://tindahan-dev.novastack-inc.online

# Unique host port for this app on the shared SAS
# Occupied by other Novastack apps: 8086, 8087, 8088, 8090
HOST_HTTP_PORT=8089

# Optional: used when deploy installs/renews Let's Encrypt via certbot
# SAS_CERTBOT_EMAIL=ops@novastack-inc.online

# Compose / app secrets on the server
POSTGRES_DB=fluent_tindahan
POSTGRES_USER=fluent
# Password is single-quoted in the Npgsql connection string to support ';' and '='. Avoid raw single quotes.
POSTGRES_PASSWORD=change_me_strong_password

ASPNETCORE_ENVIRONMENT=Production
FIREBASE_PROJECT_ID=fluent-tindahan-dev

PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxx
PAYMONGO_FRONTEND_ORIGIN=https://tindahan-dev.novastack-inc.online
