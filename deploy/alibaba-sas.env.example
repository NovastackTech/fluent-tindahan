# Alibaba Cloud Simple Application Server (SAS) deploy settings
# Copy to deploy/alibaba-sas.env (gitignored) and fill in values.

# SSH target
SAS_HOST=47.x.x.x
SAS_USER=root
SAS_PORT=22
# Absolute path to private key, or leave empty to use ssh-agent / default key
SAS_SSH_KEY=

# Remote install directory on the SAS instance
SAS_APP_DIR=/opt/fluent-tindahan

# Public URL used for PayMongo redirects and CORS origin checks
PUBLIC_ORIGIN=https://tindahan.example.com

# Compose / app secrets on the server
POSTGRES_DB=fluent_tindahan
POSTGRES_USER=fluent
POSTGRES_PASSWORD=change_me_strong_password

ASPNETCORE_ENVIRONMENT=Production
FIREBASE_PROJECT_ID=fluent-tindahan-prod

PAYMONGO_SECRET_KEY=sk_live_xxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxx
PAYMONGO_FRONTEND_ORIGIN=https://tindahan.example.com

# Published HTTP port on the SAS host (open in SAS Firewall)
HOST_HTTP_PORT=80
