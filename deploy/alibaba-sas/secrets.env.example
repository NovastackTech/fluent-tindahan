# Optional: secrets pushed to the server on the next deploy.
# Copy to deploy/alibaba-sas/secrets.env (gitignored) and fill in. Empty values are ignored.
# install.sh merges these into /opt/fluent-tindahan/.env, then deletes the uploaded copy.
# Keep the local file only as long as you need it.

# Required: the API refuses to start in Production without them.
# Note: install.sh automatically generates a unique random JWT_SECRET_KEY on first install.
# The previously committed repository dev key is burned — provide a new unique secret here if rotating.
# Generate with: openssl rand -base64 36
# JWT_SECRET_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Google OAuth 2.0 (for Google Sign-In on https://tindahan-dev.novastack-inc.online)
# Web application Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# SMTP Email OTP configuration (required when ASPNETCORE_ENVIRONMENT is Production and DemoMode is false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Fluent Tindahan
# SMTP_ENABLE_SSL=true

# Optional overrides
# DEMO_MODE=false
# ALLOW_DEMO_MODE_IN_PRODUCTION=false # Set to true ONLY if intentionally deploying an insecure demo instance in Production
# PAYMONGO_FRONTEND_ORIGIN=https://tindahan-dev.novastack-inc.online
# FIREBASE_PROJECT_ID=fluent-tindahan-dev
# ASPNETCORE_ENVIRONMENT=Production
