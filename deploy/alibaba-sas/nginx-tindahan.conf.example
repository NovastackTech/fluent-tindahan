# Host nginx fallback - only used when the server has no Caddy on ports 80/443.
# install.sh copies this to /etc/nginx/conf.d/tindahan-dev.novastack-inc.online.conf
# and runs certbot --nginx once DNS resolves (certbot adds the 443 block).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name tindahan-dev.novastack-inc.online;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
