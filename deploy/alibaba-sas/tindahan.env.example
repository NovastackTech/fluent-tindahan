# Production - Alibaba SAS @ 8.220.128.80
# Domain:  tindahan-dev.novastack-inc.online
# Install: /opt/fluent-tindahan  (this file lives at /opt/fluent-tindahan/.env)
#
# install.sh generates it on the first deploy (random POSTGRES_PASSWORD) and never overwrites it.

COMPOSE_PROJECT_NAME=fluent-tindahan
APP_URL=https://tindahan-dev.novastack-inc.online
# Bound to 127.0.0.1 only; Caddy proxies the domain to fluent-tindahan-web:80 on the novastack-edge network
HOST_HTTP_PORT=8089
ASPNETCORE_ENVIRONMENT=Production
# Demo mode defaults to false. In Production, DemoMode is ignored unless
# ALLOW_DEMO_MODE_IN_PRODUCTION=true is also explicitly set for an intentional demo server.
DEMO_MODE=false
ALLOW_DEMO_MODE_IN_PRODUCTION=false

# PostgreSQL (internal Docker network only - not exposed on the host)
POSTGRES_DB=fluent_tindahan
POSTGRES_USER=fluent
# Single-quoted in the Npgsql connection string; avoid raw single quotes.
POSTGRES_PASSWORD=change-me-to-a-strong-password

FIREBASE_PROJECT_ID=fluent-tindahan-dev

# JWT Signing Key (new unique key generated per real deployment; committed repo dev key is burned)
# Generate with: openssl rand -base64 36
JWT_SECRET_KEY=generate-a-strong-random-secret-key-at-least-32-chars

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_FRONTEND_ORIGIN=https://tindahan-dev.novastack-inc.online
