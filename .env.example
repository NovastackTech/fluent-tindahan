# Shared Docker Compose env (local + Alibaba SAS)
# Copy to `.env` for local docker runs. The SAS server .env is generated by
# deploy/alibaba-sas/install.sh (see deploy/alibaba-sas/tindahan.env.example).

POSTGRES_DB=fluent_tindahan
POSTGRES_USER=fluent
# Password is single-quoted in the Npgsql connection string to support ';' and '='. Avoid raw single quotes.
POSTGRES_PASSWORD=fluent_dev_change_me

ASPNETCORE_ENVIRONMENT=Development
FIREBASE_PROJECT_ID=fluent-tindahan-dev

# JWT Signing Key (required by docker-compose, minimum 32 characters)
# The previously committed repository dev key is burned — never use it in production!
# For production or staging deployments, generate a fresh key: openssl rand -base64 36
JWT_SECRET_KEY=fluent_local_dev_jwt_secret_key_minimum_32_chars!

# Required when ASPNETCORE_ENVIRONMENT is not Development
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_FRONTEND_ORIGIN=http://localhost:8080

# SMTP Email OTP configuration (required when ASPNETCORE_ENVIRONMENT is Production and DemoMode is false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Host port for the nginx (web) service.
# Local override uses 8080; Alibaba SAS (tindahan-dev) uses unique 8089.
HOST_HTTP_PORT=8089
